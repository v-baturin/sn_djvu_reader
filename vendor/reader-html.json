"<!doctype html><html><head>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: #fff; color: #111; font-family: sans-serif; }\n  #root { height: 100%; display: flex; flex-direction: column; }\n  #status { padding: 8px 12px; min-height: 38px; font-size: 17px; border-bottom: 1px solid #888; }\n  #pageArea { flex: 1; overflow: auto; text-align: center; background: #eee; }\n  #pageWrap { position: relative; margin: 0 auto; width: 0; height: 0; }\n  canvas { display: block; max-width: none; }\n  #page { background: #fff; }\n  #ink { position: absolute; top: 0; left: 0; background: transparent; pointer-events: none; }\n  #ink.editing { pointer-events: auto; touch-action: none; }\n  #controls { display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #888; height: 64px; flex-shrink: 0; }\n  #inkControls { display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #888; height: 60px; flex-shrink: 0; }\n  button { min-width: 72px; min-height: 48px; border: 1px solid #555; border-radius: 6px; background: #fff; color: #111; font-size: 20px; }\n  button:disabled { color: #aaa; border-color: #ccc; }\n  button.active { background: #222; color: #fff; }\n  #fitWidth, #fitHeight { min-width: 104px; font-size: 16px; }\n  #counter { min-width: 90px; }\n  #jumpDialog[hidden] { display: none; }\n  #jumpDialog { position: fixed; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; background: #0007; }\n  #jumpCard { width: min(90vw, 400px); padding: 24px; background: #fff; border: 1px solid #555; border-radius: 8px; text-align: left; }\n  #jumpCard label { display: block; font-size: 22px; margin-bottom: 12px; }\n  #jumpInput { width: 100%; height: 52px; padding: 8px 12px; border: 1px solid #555; border-radius: 6px; font-size: 24px; }\n  #jumpErro